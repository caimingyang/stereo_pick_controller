<mujoco model="robot_arm_pick_apple">
  <compiler angle="radian" meshdir="." autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" iterations="50" solver="Newton">
    <flag warmstart="enable"/>
  </option>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.6 0.8 1.0" rgb2="0.2 0.4 0.8" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" rgb1="0.9 0.9 0.9" rgb2="0.7 0.7 0.7" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="10 10" reflectance="0.1"/>
    <material name="robot_blue" rgba="0.2 0.4 0.8 1.0"/>
    <material name="robot_grey" rgba="0.3 0.3 0.35 1.0"/>
    <material name="robot_orange" rgba="0.9 0.5 0.1 1.0"/>
    <material name="apple_red" rgba="0.9 0.2 0.1 1.0"/>
    <material name="apple_green" rgba="0.3 0.7 0.2 1.0"/>
    <material name="wood" rgba="0.5 0.35 0.2 1.0"/>
  </asset>

  <worldbody>
    <!-- Ground -->
    <light name="sun" pos="1 1 3" dir="-1 -1 -3" diffuse="0.8 0.8 0.8"/>
    <light name="fill" pos="-1 0.5 2" dir="1 -0.5 -2" diffuse="0.4 0.4 0.4"/>
    <geom name="floor" type="plane" size="2 2 0.1" material="grid_mat"/>

    <!-- Table -->
    <body name="table" pos="0.35 0 0.02">
      <geom name="table_top" type="box" size="0.20 0.15 0.02" material="wood" friction="0.8"/>
    </body>

    <!-- Apple (kinematic, will be moved by controller when grasped) -->
    <body name="apple" pos="0.35 0 0.0775">
      <geom name="apple_geom" type="sphere" size="0.0375" material="apple_red"/>
      <geom name="apple_stem" type="cylinder" size="0.003 0.015" pos="0 0 0.045" material="apple_green"/>
    </body>

    <!-- ===== Robot Base ===== -->
    <body name="base_link" pos="0 0 0">
      <geom name="base_geom" type="cylinder" size="0.070 0.0175" pos="0 0 0.0175" material="robot_grey"/>

      <!-- Joint 1 -->
      <body name="link1" pos="0 0 0.035">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="5.0"/>
        <geom name="link1_geom" type="box" size="0.030 0.025 0.0625" pos="0 0 0.0625" material="robot_blue"/>

        <!-- Joint 2 -->
        <body name="link2" pos="0 0 0.125">
          <joint name="joint2" type="hinge" axis="0 1 0" range="-1.57 1.57" damping="5.0"/>
          <geom name="link2_geom" type="box" size="0.0225 0.020 0.1375" pos="0 0 0.1375" material="robot_blue"/>

          <!-- Joint 3 -->
          <body name="link3" pos="0 0 0.275">
            <joint name="joint3" type="hinge" axis="0 1 0" range="-2.0 2.0" damping="4.0"/>
            <geom name="link3_geom" type="box" size="0.020 0.0175 0.114" pos="0 0 0.114" material="robot_blue"/>

            <!-- Joint 4 -->
            <body name="link4" pos="0 0 0.228">
              <joint name="joint4" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="2.0"/>
              <geom name="link4_geom" type="box" size="0.0175 0.015 0.0525" pos="0 0 0.0525" material="robot_grey"/>

              <!-- Joint 5 -->
              <body name="link5" pos="0 0 0.105">
                <joint name="joint5" type="hinge" axis="0 1 0" range="-1.57 1.57" damping="2.0"/>
                <geom name="link5_geom" type="box" size="0.015 0.0125 0.0375" pos="0 0 0.0375" material="robot_grey"/>

                <!-- Joint 6 -->
                <body name="link6" pos="0 0 0.075">
                  <joint name="joint6" type="hinge" axis="0 0 1" range="-3.14 3.14" damping="1.0"/>
                  <geom name="link6_geom" type="box" size="0.025 0.020 0.0225" pos="0 0 0.0225" material="robot_orange"/>

                  <!-- Gripper base -->
                  <body name="gripper" pos="0 0 0.045">
                    <geom name="gripper_base" type="box" size="0.025 0.020 0.010" material="robot_orange"/>
                    <!-- Stereo cameras on gripper: binocular vision system -->
                    <camera name="left_camera" mode="targetbody" target="apple" pos="-0.03 0 0.06" fovy="70"/>
                    <camera name="right_camera" mode="targetbody" target="apple" pos="0.03 0 0.06" fovy="70"/>

                    <!-- Left finger -->
                    <body name="left_finger" pos="-0.020 0 0.030">
                      <joint name="left_gripper_joint" type="slide" axis="1 0 0" range="0 0.040" damping="0.5"/>
                      <geom name="left_finger_geom" type="box" size="0.006 0.010 0.030" material="robot_orange"/>
                    </body>

                    <!-- Right finger -->
                    <body name="right_finger" pos="0.020 0 0.030">
                      <joint name="right_gripper_joint" type="slide" axis="-1 0 0" range="0 0.040" damping="0.5"/>
                      <geom name="right_finger_geom" type="box" size="0.006 0.010 0.030" material="robot_orange"/>
                    </body>
                  </body>
                </body>
              </body>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <!-- No actuators: arm is kinematically controlled -->
</mujoco>
